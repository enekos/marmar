<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eneko.marmar</string>

    <!-- Path is substituted by install.sh with the installed bundle binary. -->
    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
    </array>

    <!-- Start at login… -->
    <key>RunAtLoad</key>
    <true/>

    <!-- …and relaunch on crash, but NOT when the user quits from the menu. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Menu-bar / UI app: run in the interactive GUI session. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/tmp/marmar.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/marmar.err.log</string>
</dict>
</plist>
